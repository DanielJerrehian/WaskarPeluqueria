{
  "crons": [
    {
      "path": "/api/cron/follow-up?shift=day",
      "schedule": "00 15 * * *"
    },
    {
      "path": "/api/cron/follow-up?shift=night",
      "schedule": "45 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|gallery/|@vite/|@react-refresh|src/|node_modules/|assets/|favicon.svg).*)",
      "destination": "/"
    }
  ]
}